# Neon Postgres connection strings (vars injected by Vercel's Neon integration).
# Local dev: 推荐用 `vercel env pull .env`，会把下面这两个名字一起拉下来。
DATABASE_URL="postgres://USER:PASS@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgres://USER:PASS@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# ---- folding-bike-manage 专用 ----
# 管理员密码：可以是明文（仅本地开发），也可以是 bcrypt 哈希（推荐生产）。
ADMIN_PASSWORD="change-me"
# 32+ 字节随机串，用于签发会话 cookie：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-openssl-rand-hex-32"
